{
  "Storage": {
    "RecordingsFolder": "../../Recordings",
    "TranscriptionsFolder": "../../Transcriptions",
    "MaxFileSizeMb": 200
  },
  "Processing": {
    "MaxConcurrency": 1
  },
  "Transcription": {
    "BaseUrl": "https://rename-easeful-substance.ngrok-free.dev/",
    "TimeoutSeconds": 660,
    "Language": "auto",
    "Prompt": "This is a natural conversation in India mixing Hindi and English (Hinglish). Transcribe the actual spoken words faithfully. Preserve English words and Hindi words as spoken. Do not translate, summarize, or invent words."
  },
  "Diarization": {
    "NumSpeakers": 2,
    "AgentSpeaksFirst": true
  },
  "Llm": {
    "Temperature": 0.2,
    "MaxTokens": 4096
  },
  "Audio": {
    "FfmpegFolder": "../../Tools/ffmpeg-n9.0-latest-win64-lgpl-9.0/bin",
    "WorkFolder": "../../Work",
    "SampleRate": 16000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
